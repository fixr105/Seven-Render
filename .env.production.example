# Backend API Configuration (Production)
# The app and API are same-origin on Vercel. Leave VITE_API_BASE_URL unset
# so the client uses /api. Set it only for a separate API origin.
# Do not add /api; the client appends it.
# VITE_API_BASE_URL=https://your-api-host.example

# Use Backend API for Authentication
VITE_USE_API_AUTH=true

# Supabase is no longer required - remove these if present
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
