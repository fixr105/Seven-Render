# Environment Variables Example
# Copy this file to .env and fill in your actual values

# API Configuration
# Unset VITE_API_BASE_URL to use Vite proxy: frontend /api -> backend :3001 (same-origin, no CORS).
# Optional: direct RAAD / PAGER fetch. No default host. When unset, the UI uses the backend API.
# VITE_N8N_RAAD_FETCH_WEBHOOK_URL=
# VITE_N8N_PAGER_FETCH_WEBHOOK_URL=
# Set to backend URL (e.g. http://localhost:3001) when frontend calls API directly; then CORS_ORIGIN must include frontend origin (e.g. http://localhost:3000).
VITE_API_BASE_URL=

# Post-submit Engine flow (proxied via /engine and /tools — never call these hosts from components)
VITE_BASE_ID=appzbyi8q7pJRl1cd
# /engine uses VITE_N8N_LEGACY_BASE_URL/webhook unless VITE_ENGINE_BASE is set.
# VITE_ENGINE_BASE=
VITE_N8N_LMS_BASE_URL=https://n8n-fvmj.srv1499064.hstgr.cloud
VITE_N8N_LEGACY_BASE_URL=https://fixrrahul.app.n8n.cloud
VITE_TOOLS_BASE=https://n8n-fvmj.srv1499064.hstgr.cloud/webhook
# Paid stamp order / eSign — exact string "true" required. Default off.
VITE_STAMP_ORDER_ENABLED=
VITE_ESIGN_ENABLED=
# Required. Login and LMS webhooks use {N8N_LMS_BASE_URL}/webhook/useraccount. No fallback host.
N8N_LMS_BASE_URL=https://n8n-fvmj.srv1499064.hstgr.cloud
# Webhooks that are not on Hostinger yet (engine, PAN, CIBIL matrix, formlink, Recordtitle, email).
N8N_LEGACY_BASE_URL=https://fixrrahul.app.n8n.cloud
# Product Documents (optional - override if n8n uses different path, e.g. product-documents)
# N8N_GET_PRODUCT_DOCUMENTS_URL=${N8N_BASE_URL}/webhook/productdocument
# N8N_POST_PRODUCT_DOCUMENTS_URL=${N8N_BASE_URL}/webhook/productdocument
# N8N_PATCH_PRODUCT_DOCUMENTS_URL=${N8N_BASE_URL}/webhook/productdocument
# N8N_DELETE_PRODUCT_DOCUMENTS_URL=${N8N_BASE_URL}/webhook/productdocument
# Loan Products (optional - override if n8n uses different path)
# N8N_PATCH_LOAN_PRODUCTS_URL=
# N8N_DELETE_LOAN_PRODUCTS_URL=
# CIBIL-based dynamic rate matrix (ROI% / PF% by CIBIL band). Consumed by GET /api/config/cibil-rate-matrix.
# Built from N8N_LEGACY_BASE_URL/webhook/getmatrix when unset.
# CIBIL_RATE_MATRIX_WEBHOOK_URL=
PORT=3001

# AI Summary (default for credit team: big-brain-bro; same POST body as /webhook/loanapplications)
# Optional full URL. When unset, AI summary skips this webhook (it does not guess a host).
# N8N_BIG_BRAIN_BRO_URL=

# E2E Test Credentials
# Used by Playwright E2E and backend tests. For tests always use: Sagar@gmail.com / pass@123
E2E_CLIENT_USERNAME=Sagar@gmail.com
E2E_CLIENT_PASSWORD=pass@123
E2E_KAM_USERNAME=Sagar@gmail.com
E2E_KAM_PASSWORD=pass@123
E2E_CREDIT_USERNAME=Sagar@gmail.com
E2E_CREDIT_PASSWORD=pass@123
E2E_NBFC_USERNAME=Sagar@gmail.com
E2E_NBFC_PASSWORD=pass@123

# Backend Configuration
NODE_ENV=development
# Comma-separated allowed origins. Must include frontend origin when using explicit VITE_API_BASE_URL.
# Vite dev server runs on :3000; use http://localhost:3000 (not :8000).
CORS_ORIGIN=http://localhost:3000

# Auth (required in production). Generate: openssl rand -base64 32
JWT_SECRET=

# Optional: enable n8n reachability check in /health (default: disabled to avoid exhausting n8n executions)
# N8N_HEALTH_CHECK_ENABLED=true

# Database/Webhook Configuration
# Add other environment variables as needed

# Geo-tagged photo uploads (Section 6) — defaults to ${N8N_BASE_URL}/webhook/UPL1|UPL2|UPL3
# N8N_GEO_UPLOAD_UPL1_URL=
# N8N_GEO_UPLOAD_UPL2_URL=
# N8N_GEO_UPLOAD_UPL3_URL=
# ONEDRIVE_UPLOAD_URL=  # non-geo document uploads
